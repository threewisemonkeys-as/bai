  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/ENV",
    "build",
    "dist",
    "**/.eggs",
    "**/*.egg-info",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.pyre",
    "**/.pytype",
    "**/cython_debug",
    "**/.ipynb_checkpoints",
    "**/htmlcov",
    "**/.tox",
    "**/.nox",
    "**/.cache",
    "**/.hypothesis",
    "logs",
    "data",
    "nle_data",
    "environment_files",
    "ttyrecs.db",
    "**/.claude",
    "**/.zed",
    "**/.vscode",
    "**/log_environment_interfaces*.txt",
    "**/SECRETS",
    "**/__marimo__",
